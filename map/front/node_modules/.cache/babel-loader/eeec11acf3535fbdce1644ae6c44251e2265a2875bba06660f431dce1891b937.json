{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport maplibregl from 'maplibre-gl'; // Nhớ cài đặt maplibre-gl\n\nexport default {\n  props: {\n    selectedLocation: {\n      type: Array,\n      default: () => [105.85242472181584, 21.029579719995272]\n    }\n  },\n  data() {\n    return {\n      map: null,\n      apiUrl: 'https://rsapi.goong.io',\n      mapUrl: 'https://tiles.goong.io/assets/',\n      apiKey: 'ArPlUISaEBAdJFTABi9dcNGcue8WQ4cOAuGcNoBE',\n      // your API key\n      mapKey: 'tLyW2vk0aY3yfQLu8ZPy986mAgaW8igMYufv3BLY',\n      // your map key\n      center: [105.85242472181584, 21.029579719995272],\n      // Kinh độ, vĩ độ\n      zoom: 14 // Độ zoom mặc định\n    };\n  },\n  mounted() {\n    this.initMap();\n  },\n  watch: {\n    selectedLocation: 'moveToLocation' // Theo dõi thay đổi tọa độ\n  },\n  methods: {\n    initMap() {\n      this.map = new maplibregl.Map({\n        container: 'map',\n        style: `${this.mapUrl}goong_map_web.json?api_key=${this.mapKey}`,\n        center: this.selectedLocation,\n        zoom: 14\n      });\n    },\n    moveToLocation(newLocation) {\n      this.map.flyTo({\n        center: newLocation,\n        essential: true\n      });\n      this.addMarkerAndCircleAround(newLocation);\n    },\n    addMarkerAndCircleAround(lngLat) {\n      // Xóa các marker và vòng tròn cũ nếu có\n      this.map.eachLayer(layer => {\n        if (layer.id === 'marker' || layer.id === 'circle') {\n          this.map.removeLayer(layer.id);\n          this.map.removeSource(layer.id);\n        }\n      });\n\n      // Thêm marker\n      new maplibregl.Marker({\n        id: 'marker'\n      }).setLngLat(lngLat).addTo(this.map);\n\n      // Thêm vòng tròn\n      const radiusInMeters = 100; // Đường kính vòng tròn\n      const circle = {\n        type: 'FeatureCollection',\n        features: [{\n          type: 'Feature',\n          properties: {},\n          geometry: {\n            type: 'Point',\n            coordinates: lngLat\n          }\n        }]\n      };\n      this.map.addSource('circle', {\n        type: 'geojson',\n        data: circle\n      });\n      this.map.addLayer({\n        id: 'circle',\n        type: 'circle',\n        source: 'circle',\n        paint: {\n          'circle-radius': radiusInMeters / 100,\n          // Chuyển đổi mét thành pixel\n          'circle-color': '#FF0000',\n          'circle-opacity': 0.5\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["maplibregl","props","selectedLocation","type","Array","default","data","map","apiUrl","mapUrl","apiKey","mapKey","center","zoom","mounted","initMap","watch","methods","Map","container","style","moveToLocation","newLocation","flyTo","essential","addMarkerAndCircleAround","lngLat","eachLayer","layer","id","removeLayer","removeSource","Marker","setLngLat","addTo","radiusInMeters","circle","features","properties","geometry","coordinates","addSource","addLayer","source","paint"],"sources":["/home/sonhippo/Documents/2.Seminar 7/2. PBL6/PBL-6/map/front/src/components/MapComponent.vue"],"sourcesContent":["<template>\n    <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\n</template>\n\n<script>\nimport maplibregl from 'maplibre-gl'; // Nhớ cài đặt maplibre-gl\n\nexport default {\n    props: {\n        selectedLocation: {\n            type: Array,\n            default: () => [105.85242472181584, 21.029579719995272]\n        }\n    },\n    data() {\n        return {\n            map: null,\n            apiUrl: 'https://rsapi.goong.io',\n            mapUrl: 'https://tiles.goong.io/assets/',\n            apiKey: 'ArPlUISaEBAdJFTABi9dcNGcue8WQ4cOAuGcNoBE', // your API key\n            mapKey: 'tLyW2vk0aY3yfQLu8ZPy986mAgaW8igMYufv3BLY', // your map key\n            center: [105.85242472181584, 21.029579719995272], // Kinh độ, vĩ độ\n            zoom: 14, // Độ zoom mặc định\n        };\n    },\n    mounted() {\n        this.initMap();\n    },\n    watch: {\n        selectedLocation: 'moveToLocation' // Theo dõi thay đổi tọa độ\n    },\n    methods: {\n        initMap() {\n            this.map = new maplibregl.Map({\n                container: 'map',\n                style: `${this.mapUrl}goong_map_web.json?api_key=${this.mapKey}`,\n                center: this.selectedLocation,\n                zoom: 14\n            });\n            \n        },\n        moveToLocation(newLocation) {\n            this.map.flyTo({\n                center: newLocation,\n                essential: true\n            });\n            this.addMarkerAndCircleAround(newLocation);\n        },\n        addMarkerAndCircleAround(lngLat) {\n            // Xóa các marker và vòng tròn cũ nếu có\n            this.map.eachLayer((layer) => {\n                if (layer.id === 'marker' || layer.id === 'circle') {\n                    this.map.removeLayer(layer.id);\n                    this.map.removeSource(layer.id);\n                }\n            });\n\n            // Thêm marker\n            new maplibregl.Marker({ id: 'marker' })\n                .setLngLat(lngLat)\n                .addTo(this.map);\n\n            // Thêm vòng tròn\n            const radiusInMeters = 100; // Đường kính vòng tròn\n            const circle = {\n                type: 'FeatureCollection',\n                features: [\n                    {\n                        type: 'Feature',\n                        properties: {},\n                        geometry: {\n                            type: 'Point',\n                            coordinates: lngLat\n                        }\n                    }\n                ]\n            };\n\n            this.map.addSource('circle', {\n                type: 'geojson',\n                data: circle\n            });\n\n            this.map.addLayer({\n                id: 'circle',\n                type: 'circle',\n                source: 'circle',\n                paint: {\n                    'circle-radius': radiusInMeters / 100, // Chuyển đổi mét thành pixel\n                    'circle-color': '#FF0000',\n                    'circle-opacity': 0.5\n                }\n            });\n        }\n    }\n};\n</script>"],"mappings":";AAKA,OAAOA,UAAS,MAAO,aAAa,EAAE;;AAEtC,eAAe;EACXC,KAAK,EAAE;IACHC,gBAAgB,EAAE;MACdC,IAAI,EAAEC,KAAK;MACXC,OAAO,EAAEA,CAAA,KAAM,CAAC,kBAAkB,EAAE,kBAAkB;IAC1D;EACJ,CAAC;EACDC,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,GAAG,EAAE,IAAI;MACTC,MAAM,EAAE,wBAAwB;MAChCC,MAAM,EAAE,gCAAgC;MACxCC,MAAM,EAAE,0CAA0C;MAAE;MACpDC,MAAM,EAAE,0CAA0C;MAAE;MACpDC,MAAM,EAAE,CAAC,kBAAkB,EAAE,kBAAkB,CAAC;MAAE;MAClDC,IAAI,EAAE,EAAE,CAAE;IACd,CAAC;EACL,CAAC;EACDC,OAAOA,CAAA,EAAG;IACN,IAAI,CAACC,OAAO,CAAC,CAAC;EAClB,CAAC;EACDC,KAAK,EAAE;IACHd,gBAAgB,EAAE,gBAAe,CAAE;EACvC,CAAC;EACDe,OAAO,EAAE;IACLF,OAAOA,CAAA,EAAG;MACN,IAAI,CAACR,GAAE,GAAI,IAAIP,UAAU,CAACkB,GAAG,CAAC;QAC1BC,SAAS,EAAE,KAAK;QAChBC,KAAK,EAAE,GAAG,IAAI,CAACX,MAAM,8BAA8B,IAAI,CAACE,MAAM,EAAE;QAChEC,MAAM,EAAE,IAAI,CAACV,gBAAgB;QAC7BW,IAAI,EAAE;MACV,CAAC,CAAC;IAEN,CAAC;IACDQ,cAAcA,CAACC,WAAW,EAAE;MACxB,IAAI,CAACf,GAAG,CAACgB,KAAK,CAAC;QACXX,MAAM,EAAEU,WAAW;QACnBE,SAAS,EAAE;MACf,CAAC,CAAC;MACF,IAAI,CAACC,wBAAwB,CAACH,WAAW,CAAC;IAC9C,CAAC;IACDG,wBAAwBA,CAACC,MAAM,EAAE;MAC7B;MACA,IAAI,CAACnB,GAAG,CAACoB,SAAS,CAAEC,KAAK,IAAK;QAC1B,IAAIA,KAAK,CAACC,EAAC,KAAM,QAAO,IAAKD,KAAK,CAACC,EAAC,KAAM,QAAQ,EAAE;UAChD,IAAI,CAACtB,GAAG,CAACuB,WAAW,CAACF,KAAK,CAACC,EAAE,CAAC;UAC9B,IAAI,CAACtB,GAAG,CAACwB,YAAY,CAACH,KAAK,CAACC,EAAE,CAAC;QACnC;MACJ,CAAC,CAAC;;MAEF;MACA,IAAI7B,UAAU,CAACgC,MAAM,CAAC;QAAEH,EAAE,EAAE;MAAS,CAAC,EACjCI,SAAS,CAACP,MAAM,EAChBQ,KAAK,CAAC,IAAI,CAAC3B,GAAG,CAAC;;MAEpB;MACA,MAAM4B,cAAa,GAAI,GAAG,EAAE;MAC5B,MAAMC,MAAK,GAAI;QACXjC,IAAI,EAAE,mBAAmB;QACzBkC,QAAQ,EAAE,CACN;UACIlC,IAAI,EAAE,SAAS;UACfmC,UAAU,EAAE,CAAC,CAAC;UACdC,QAAQ,EAAE;YACNpC,IAAI,EAAE,OAAO;YACbqC,WAAW,EAAEd;UACjB;QACJ;MAER,CAAC;MAED,IAAI,CAACnB,GAAG,CAACkC,SAAS,CAAC,QAAQ,EAAE;QACzBtC,IAAI,EAAE,SAAS;QACfG,IAAI,EAAE8B;MACV,CAAC,CAAC;MAEF,IAAI,CAAC7B,GAAG,CAACmC,QAAQ,CAAC;QACdb,EAAE,EAAE,QAAQ;QACZ1B,IAAI,EAAE,QAAQ;