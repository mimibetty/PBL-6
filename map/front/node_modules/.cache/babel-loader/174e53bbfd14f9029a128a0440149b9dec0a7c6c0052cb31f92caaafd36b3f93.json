{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nexport default {\n  data() {\n    return {\n      location: '',\n      map: null,\n      marker: null,\n      circle: null\n    };\n  },\n  methods: {\n    initMap() {\n      const mapOptions = {\n        center: {\n          lat: 0,\n          lng: 0\n        },\n        zoom: 2\n      };\n      this.map = new google.maps.Map(this.$refs.map, mapOptions);\n    },\n    async searchLocation() {\n      const response = await fetch(`http://localhost:8000/autocomplete`, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json'\n        },\n        body: JSON.stringify({\n          input: this.location\n        })\n      });\n      const data = await response.json();\n      if (data.predictions && data.predictions.length) {\n        const placeId = data.predictions[0].place_id;\n        const placeDetailResponse = await fetch(`http://localhost:8000/place-detail`, {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            place_id: placeId\n          })\n        });\n        const placeDetail = await placeDetailResponse.json();\n        this.displayLocation(placeDetail.result.geometry.location);\n      } else {\n        alert(\"Location not found\");\n      }\n    },\n    displayLocation(location) {\n      const latLng = {\n        lat: location.lat,\n        lng: location.lng\n      };\n      if (this.marker) {\n        this.marker.setMap(null); // Remove previous marker\n      }\n      if (this.circle) {\n        this.circle.setMap(null); // Remove previous circle\n      }\n      this.marker = new google.maps.Marker({\n        position: latLng,\n        map: this.map,\n        title: this.location\n      });\n      this.circle = new google.maps.Circle({\n        map: this.map,\n        radius: 1000,\n        // in meters\n        fillColor: '#AA0000',\n        fillOpacity: 0.35,\n        strokeColor: '#AA0000',\n        strokeOpacity: 0.8,\n        strokeWeight: 2,\n        center: latLng\n      });\n      this.map.setCenter(latLng);\n      this.map.setZoom(15);\n    }\n  },\n  mounted() {\n    this.initMap();\n    // Load Google Maps script\n    const script = document.createElement('script');\n    script.src = `https://maps.googleapis.com/maps/api/js?key=YOUR_GOOGLE_MAPS_API_KEY`;\n    script.async = true;\n    script.defer = true;\n    document.head.appendChild(script);\n  }\n};","map":{"version":3,"names":["data","location","map","marker","circle","methods","initMap","mapOptions","center","lat","lng","zoom","google","maps","Map","$refs","searchLocation","response","fetch","method","headers","body","JSON","stringify","input","json","predictions","length","placeId","place_id","placeDetailResponse","placeDetail","displayLocation","result","geometry","alert","latLng","setMap","Marker","position","title","Circle","radius","fillColor","fillOpacity","strokeColor","strokeOpacity","strokeWeight","setCenter","setZoom","mounted","script","document","createElement","src","async","defer","head","appendChild"],"sources":["/home/sonhippo/Documents/2.Seminar 7/2. PBL6/PBL-6/map/front/src/components/MapComponent.vue"],"sourcesContent":["<template>\n    <div>\n      <input v-model=\"location\" @keyup.enter=\"searchLocation\" placeholder=\"Enter location...\" />\n      <div ref=\"map\" style=\"height: 500px; width: 100%;\"></div>\n    </div>\n  </template>\n  \n  <script>\n  export default {\n    data() {\n      return {\n        location: '',\n        map: null,\n        marker: null,\n        circle: null,\n      };\n    },\n    methods: {\n      initMap() {\n        const mapOptions = {\n          center: { lat: 0, lng: 0 },\n          zoom: 2,\n        };\n        this.map = new google.maps.Map(this.$refs.map, mapOptions);\n      },\n      async searchLocation() {\n        const response = await fetch(`http://localhost:8000/autocomplete`, {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json',\n          },\n          body: JSON.stringify({ input: this.location }),\n        });\n        const data = await response.json();\n        if (data.predictions && data.predictions.length) {\n          const placeId = data.predictions[0].place_id;\n          const placeDetailResponse = await fetch(`http://localhost:8000/place-detail`, {\n            method: 'POST',\n            headers: {\n              'Content-Type': 'application/json',\n            },\n            body: JSON.stringify({ place_id: placeId }),\n          });\n          const placeDetail = await placeDetailResponse.json();\n          this.displayLocation(placeDetail.result.geometry.location);\n        } else {\n          alert(\"Location not found\");\n        }\n      },\n      displayLocation(location) {\n        const latLng = { lat: location.lat, lng: location.lng };\n  \n        if (this.marker) {\n          this.marker.setMap(null); // Remove previous marker\n        }\n        if (this.circle) {\n          this.circle.setMap(null); // Remove previous circle\n        }\n  \n        this.marker = new google.maps.Marker({\n          position: latLng,\n          map: this.map,\n          title: this.location,\n        });\n  \n        this.circle = new google.maps.Circle({\n          map: this.map,\n          radius: 1000, // in meters\n          fillColor: '#AA0000',\n          fillOpacity: 0.35,\n          strokeColor: '#AA0000',\n          strokeOpacity: 0.8,\n          strokeWeight: 2,\n          center: latLng,\n        });\n  \n        this.map.setCenter(latLng);\n        this.map.setZoom(15);\n      },\n    },\n    mounted() {\n      this.initMap();\n      // Load Google Maps script\n      const script = document.createElement('script');\n      script.src = `https://maps.googleapis.com/maps/api/js?key=YOUR_GOOGLE_MAPS_API_KEY`;\n      script.async = true;\n      script.defer = true;\n      document.head.appendChild(script);\n    },\n  };\n  </script>\n  \n  <style>\n  /* Bạn có thể thêm CSS ở đây */\n  </style>"],"mappings":";AAQE,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,GAAG,EAAE,IAAI;MACTC,MAAM,EAAE,IAAI;MACZC,MAAM,EAAE;IACV,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,OAAOA,CAAA,EAAG;MACR,MAAMC,UAAS,GAAI;QACjBC,MAAM,EAAE;UAAEC,GAAG,EAAE,CAAC;UAAEC,GAAG,EAAE;QAAE,CAAC;QAC1BC,IAAI,EAAE;MACR,CAAC;MACD,IAAI,CAACT,GAAE,GAAI,IAAIU,MAAM,CAACC,IAAI,CAACC,GAAG,CAAC,IAAI,CAACC,KAAK,CAACb,GAAG,EAAEK,UAAU,CAAC;IAC5D,CAAC;IACD,MAAMS,cAAcA,CAAA,EAAG;MACrB,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAAC,oCAAoC,EAAE;QACjEC,MAAM,EAAE,MAAM;QACdC,OAAO,EAAE;UACP,cAAc,EAAE;QAClB,CAAC;QACDC,IAAI,EAAEC,IAAI,CAACC,SAAS,CAAC;UAAEC,KAAK,EAAE,IAAI,CAACvB;QAAS,CAAC;MAC/C,CAAC,CAAC;MACF,MAAMD,IAAG,GAAI,MAAMiB,QAAQ,CAACQ,IAAI,CAAC,CAAC;MAClC,IAAIzB,IAAI,CAAC0B,WAAU,IAAK1B,IAAI,CAAC0B,WAAW,CAACC,MAAM,EAAE;QAC/C,MAAMC,OAAM,GAAI5B,IAAI,CAAC0B,WAAW,CAAC,CAAC,CAAC,CAACG,QAAQ;QAC5C,MAAMC,mBAAkB,GAAI,MAAMZ,KAAK,CAAC,oCAAoC,EAAE;UAC5EC,MAAM,EAAE,MAAM;UACdC,OAAO,EAAE;YACP,cAAc,EAAE;UAClB,CAAC;UACDC,IAAI,EAAEC,IAAI,CAACC,SAAS,CAAC;YAAEM,QAAQ,EAAED;UAAQ,CAAC;QAC5C,CAAC,CAAC;QACF,MAAMG,WAAU,GAAI,MAAMD,mBAAmB,CAACL,IAAI,CAAC,CAAC;QACpD,IAAI,CAACO,eAAe,CAACD,WAAW,CAACE,MAAM,CAACC,QAAQ,CAACjC,QAAQ,CAAC;MAC5D,OAAO;QACLkC,KAAK,CAAC,oBAAoB,CAAC;MAC7B;IACF,CAAC;IACDH,eAAeA,CAAC/B,QAAQ,EAAE;MACxB,MAAMmC,MAAK,GAAI;QAAE3B,GAAG,EAAER,QAAQ,CAACQ,GAAG;QAAEC,GAAG,EAAET,QAAQ,CAACS;MAAI,CAAC;MAEvD,IAAI,IAAI,CAACP,MAAM,EAAE;QACf,IAAI,CAACA,MAAM,CAACkC,MAAM,CAAC,IAAI,CAAC,EAAE;MAC5B;MACA,IAAI,IAAI,CAACjC,MAAM,EAAE;QACf,IAAI,CAACA,MAAM,CAACiC,MAAM,CAAC,IAAI,CAAC,EAAE;MAC5B;MAEA,IAAI,CAAClC,MAAK,GAAI,IAAIS,MAAM,CAACC,IAAI,CAACyB,MAAM,CAAC;QACnCC,QAAQ,EAAEH,MAAM;QAChBlC,GAAG,EAAE,IAAI,CAACA,GAAG;QACbsC,KAAK,EAAE,IAAI,CAACvC;MACd,CAAC,CAAC;MAEF,IAAI,CAACG,MAAK,GAAI,IAAIQ,MAAM,CAACC,IAAI,CAAC4B,MAAM,CAAC;QACnCvC,GAAG,EAAE,IAAI,CAACA,GAAG;QACbwC,MAAM,EAAE,IAAI;QAAE;QACdC,SAAS,EAAE,SAAS;QACpBC,WAAW,EAAE,IAAI;QACjBC