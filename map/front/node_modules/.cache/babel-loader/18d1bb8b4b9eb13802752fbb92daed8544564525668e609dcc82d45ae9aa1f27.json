{"ast":null,"code":"import { createElementVNode as _createElementVNode, createStaticVNode as _createStaticVNode, openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", null, _cache[0] || (_cache[0] = [_createStaticVNode(\"<input id=\\\"input\\\" type=\\\"text\\\" placeholder=\\\"Nhập địa điểm...\\\"><div id=\\\"result\\\" class=\\\"result-container\\\" style=\\\"display:none;\\\"></div><div id=\\\"map\\\" style=\\\"height:500px;width:100%;\\\"></div><div id=\\\"popover-change-style\\\" class=\\\"popover\\\" style=\\\"display:none;\\\"></div><button id=\\\"choose-map-style\\\" class=\\\"popover-button\\\">Change Map Style</button><div id=\\\"get-directions-box\\\" style=\\\"display:none;\\\"><input id=\\\"start\\\" placeholder=\\\"Bắt đầu\\\"><input id=\\\"end\\\" placeholder=\\\"Kết thúc\\\"><button id=\\\"get-directions\\\">Get Directions</button><button id=\\\"close-directions\\\">Close</button></div>\", 6)]));\n}","map":{"version":3,"names":["_createElementBlock","_cache","_createStaticVNode"],"sources":["/home/sonhippo/Documents/2.Seminar 7/2. PBL6/PBL-6/map/front/src/components/MapComponent.vue"],"sourcesContent":["<template>\n    <div>\n      <input id=\"input\" type=\"text\" placeholder=\"Nhập địa điểm...\" />\n      <div id=\"result\" class=\"result-container\" style=\"display: none;\"></div>\n      <div id=\"map\" style=\"height: 500px; width: 100%;\"></div>\n      <div id=\"popover-change-style\" class=\"popover\" style=\"display: none;\"></div>\n      <button id=\"choose-map-style\" class=\"popover-button\">Change Map Style</button>\n      <div id=\"get-directions-box\" style=\"display: none;\">\n        <input id=\"start\" placeholder=\"Bắt đầu\" />\n        <input id=\"end\" placeholder=\"Kết thúc\" />\n        <button id=\"get-directions\">Get Directions</button>\n        <button id=\"close-directions\">Close</button>\n      </div>\n    </div>\n  </template>\n  \n  <script>\n  import maplibregl from 'maplibre-gl';\n  \n  export default {\n    data() {\n      return {\n        apiUrl: 'https://rsapi.goong.io',\n        mapUrl: 'https://tiles.goong.io/assets/',\n        apiKey: 'ArPlUISaEBAdJFTABi9dcNGcue8WQ4cOAuGcNoBE', // your API key\n        mapKey: 'tLyW2vk0aY3yfQLu8ZPy986mAgaW8igMYufv3BLY', // your map key\n        directionVehicle: 'car',\n        center: [105.85242472181584, 21.029579719995272],\n        zoom: 14,\n        radiusInMeters: 100,\n        map: null,\n        mapStyles: null\n      };\n    },\n    mounted() {\n      this.initMap();\n      this.renderMapStyleOptions();\n      this.setupAutocomplete();\n    },\n    methods: {\n      initMap() {\n        console.log('mapUrl:', this.mapUrl);\n        console.log('mapKey:', this.mapKey);\n        this.map = new maplibregl.Map({\n          container: 'map',\n          style: this.mapStyles[0].url,\n          center: this.center,\n          zoom: this.zoom\n        });\n        this.mapStyles =  [\n          { name: 'Normal', url: `${this.mapUrl}goong_map_web.json?api_key=${this.mapKey}` },\n          { name: 'Satellite', url: `${this.mapUrl}goong_satellite.json?api_key=${this.mapKey}` },\n          { name: 'Dark', url: `${this.mapUrl}goong_map_dark.json?api_key=${this.mapKey}` },\n          { name: 'Light', url: `${this.mapUrl}navigation_day.json?api_key=${this.mapKey}` },\n          { name: 'Night', url: `${this.mapUrl}navigation_night.json?api_key=${this.mapKey}` }\n        ]\n  \n        this.map.on('load', () => {\n          this.addCircleAndMarker(this.center);\n        });\n      },\n      drawCircle(center, radiusInMeters) {\n        const points = 64;\n        const coords = {\n          latitude: center[1],\n          longitude: center[0]\n        };\n        const km = radiusInMeters / 1000;\n        const ret = [];\n        const distanceX = km / (111.320 * Math.cos(coords.latitude * Math.PI / 180));\n        const distanceY = km / 110.574;\n        let theta, x, y;\n        for (let i = 0; i < points; i++) {\n          theta = (i / points) * (2 * Math.PI);\n          x = distanceX * Math.cos(theta);\n          y = distanceY * Math.sin(theta);\n          ret.push([coords.longitude + x, coords.latitude + y]);\n        }\n        ret.push(ret[0]);\n        return ret;\n      },\n      addCircleAndMarker(center) {\n        const circleData = {\n          'type': 'FeatureCollection',\n          'features': [{\n            'type': 'Feature',\n            'geometry': {\n              'type': 'Polygon',\n              'coordinates': [this.drawCircle(center, this.radiusInMeters)]\n            }\n          }]\n        };\n        this.map.addSource('circle', {\n          'type': 'geojson',\n          'data': circleData\n        });\n        new maplibregl.Marker().setLngLat(center).addTo(this.map);\n        this.map.addLayer({\n          id: 'circle',\n          type: 'fill',\n          source: 'circle',\n          layout: {},\n          paint: {\n            'fill-color': '#588888',\n            'fill-opacity': 0.5\n          }\n        });\n      },\n      renderMapStyleOptions() {\n        const popover = document.getElementById('popover-change-style');\n        this.mapStyles.forEach(style => {\n          const div = document.createElement('div');\n          div.className = 'map-style-option';\n          div.textContent = style.name;\n          div.onclick = () => this.changeStyle(style.url, style.name);\n          popover.appendChild(div);\n        });\n      },\n      changeStyle(styleUrl, name) {\n        this.map.setStyle(styleUrl);\n        document.querySelector('.popover-button').textContent = name;\n        const popover = document.getElementById('popover-change-style');\n        popover.style.display = (popover.style.display === 'block') ? 'none' : 'block';\n      },\n      setupAutocomplete() {\n        const input = document.getElementById('input');\n        input.addEventListener('input', () => {\n          const query = input.value;\n          if (query.length >= 2) {\n            this.fetchDataAutoComplete(query);\n          } else {\n            this.renderArray([]); // Clear results if input is less than 2 characters\n          }\n        });\n      },\n      fetchDataAutoComplete(query) {\n        const apiLink = `${this.apiUrl}/Place/AutoComplete?api_key=${this.apiKey}&input=${encodeURIComponent(query)}`;\n        fetch(apiLink)\n          .then(response => response.json())\n          .then(data => {\n            if (data.predictions) {\n              this.renderArray(data.predictions);\n            } else {\n              this.renderArray([]);\n            }\n          })\n          .catch(error => {\n            console.error('Error fetching data:', error);\n            this.renderArray([]);\n          });\n      },\n      renderArray(data) {\n        const resultContainer = document.getElementById('result');\n        resultContainer.innerHTML = ''; // Clear previous results\n        if (data.length > 0) {\n          resultContainer.style.display = 'block';\n        } else {\n          resultContainer.style.display = 'none';\n        }\n        data.forEach(item => {\n          const div = document.createElement('div');\n          div.className = 'result-box';\n          div.textContent = item.description;\n          div.addEventListener('click', () => {\n            this.fetchPlaceDetails(item.place_id);\n            resultContainer.style.display = 'none';\n            document.getElementById('input').value = item.description;\n          });\n          resultContainer.appendChild(div);\n        });\n      },\n      fetchPlaceDetails(placeId) {\n        const apiLink = `${this.apiUrl}/Place/Detail?api_key=${this.apiKey}&place_id=${placeId}`;\n        fetch(apiLink)\n          .then(response => response.json())\n          .then(data => {\n            if (data.result) {\n              const { location } = data.result.geometry;\n              const lngLat = [location.lng, location.lat];\n              this.addMarkerAndCircleAround(lngLat);\n            } else {\n              console.error('No result found for place details');\n            }\n          })\n          .catch(error => {\n            console.error('Error fetching place details:', error);\n          });\n      },\n      addMarkerAndCircleAround(lngLat) {\n        new maplibregl.Marker().setLngLat(lngLat).addTo(this.map);\n        if (this.map.getLayer('circle')) {\n          this.map.removeLayer('circle');\n          this.map.removeSource('circle');\n        }\n        const circleData = {\n          'type': 'FeatureCollection',\n          'features': [{\n            'type': 'Feature',\n            'geometry': {\n              'type': 'Polygon',\n              'coordinates': [this.drawCircle(lngLat, this.radiusInMeters)]\n            }\n          }]\n        };\n        this.map.addSource('circle', {\n          'type': 'geojson',\n          'data': circleData\n        });\n        this.map.addLayer({\n          'id': 'circle',\n          'type': 'fill',\n          'source': 'circle',\n          'layout': {},\n          'paint': {\n            'fill-color': '#588888',\n            'fill-opacity': 0.5\n          }\n        });\n        this.map.flyTo({ center: lngLat, zoom: this.zoom });\n      },\n      // Directions and other related functions can be added here\n    }\n  };\n  </script>\n  \n  <style>\n  .result-container {\n    border: 1px solid #ccc;\n    max-height: 200px;\n    overflow-y: auto;\n    position: absolute;\n    background: white;\n    z-index: 10;\n  }\n  .result-box {\n    padding: 10px;\n    cursor: pointer;\n  }\n  .result-box:hover {\n    background-color: #f0f0f0;\n  }\n  </style>"],"mappings":";;uBACIA,mBAAA,CAYM,aAAAC,MAAA,QAAAA,MAAA,OAbVC,kBAAA,0mB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}