{"ast":null,"code":"import { vModelText as _vModelText, withKeys as _withKeys, createElementVNode as _createElementVNode, withDirectives as _withDirectives, openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  ref: \"map\",\n  style: {\n    \"height\": \"500px\",\n    \"width\": \"100%\"\n  }\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", null, [_withDirectives(_createElementVNode(\"input\", {\n    \"onUpdate:modelValue\": _cache[0] || (_cache[0] = $event => $data.location = $event),\n    onKeyup: _cache[1] || (_cache[1] = _withKeys((...args) => $options.searchLocation && $options.searchLocation(...args), [\"enter\"])),\n    placeholder: \"Enter location...\"\n  }, null, 544 /* NEED_HYDRATION, NEED_PATCH */), [[_vModelText, $data.location]]), _createElementVNode(\"div\", _hoisted_1, null, 512 /* NEED_PATCH */)]);\n}","map":{"version":3,"names":["ref","style","_createElementBlock","_createElementVNode","_cache","$event","$data","location","onKeyup","_withKeys","args","$options","searchLocation","placeholder","_hoisted_1"],"sources":["/home/sonhippo/Documents/2.Seminar 7/2. PBL6/PBL-6/map/front/src/components/MapComponent.vue"],"sourcesContent":["<template>\n    <div>\n      <input v-model=\"location\" @keyup.enter=\"searchLocation\" placeholder=\"Enter location...\" />\n      <div ref=\"map\" style=\"height: 500px; width: 100%;\"></div>\n    </div>\n  </template>\n  \n  <script>\n  export default {\n    data() {\n      return {\n        location: '',\n        map: null,\n        marker: null,\n        circle: null,\n      };\n    },\n    methods: {\n      initMap() {\n        const mapOptions = {\n          center: { lat: 0, lng: 0 },\n          zoom: 2,\n        };\n        this.map = new google.maps.Map(this.$refs.map, mapOptions);\n      },\n      async searchLocation() {\n        const response = await fetch(`http://localhost:8000/autocomplete`, {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json',\n          },\n          body: JSON.stringify({ input: this.location }),\n        });\n        const data = await response.json();\n        if (data.predictions && data.predictions.length) {\n          const placeId = data.predictions[0].place_id;\n          const placeDetailResponse = await fetch(`http://localhost:8000/place-detail`, {\n            method: 'POST',\n            headers: {\n              'Content-Type': 'application/json',\n            },\n            body: JSON.stringify({ place_id: placeId }),\n          });\n          const placeDetail = await placeDetailResponse.json();\n          this.displayLocation(placeDetail.result.geometry.location);\n        } else {\n          alert(\"Location not found\");\n        }\n      },\n      displayLocation(location) {\n        const latLng = { lat: location.lat, lng: location.lng };\n  \n        if (this.marker) {\n          this.marker.setMap(null); // Remove previous marker\n        }\n        if (this.circle) {\n          this.circle.setMap(null); // Remove previous circle\n        }\n  \n        this.marker = new google.maps.Marker({\n          position: latLng,\n          map: this.map,\n          title: this.location,\n        });\n  \n        this.circle = new google.maps.Circle({\n          map: this.map,\n          radius: 1000, // in meters\n          fillColor: '#AA0000',\n          fillOpacity: 0.35,\n          strokeColor: '#AA0000',\n          strokeOpacity: 0.8,\n          strokeWeight: 2,\n          center: latLng,\n        });\n  \n        this.map.setCenter(latLng);\n        this.map.setZoom(15);\n      },\n    },\n    mounted() {\n      this.initMap();\n      // Load Google Maps script\n      const script = document.createElement('script');\n      script.src = `https://maps.googleapis.com/maps/api/js?key=YOUR_GOOGLE_MAPS_API_KEY`;\n      script.async = true;\n      script.defer = true;\n      document.head.appendChild(script);\n    },\n  };\n  </script>\n  \n  <style>\n  /* Bạn có thể thêm CSS ở đây */\n  </style>"],"mappings":";;EAGWA,GAAG,EAAC,KAAK;EAACC,KAAmC,EAAnC;IAAA;IAAA;EAAA;;;uBAFjBC,mBAAA,CAGM,c,gBAFJC,mBAAA,CAA0F;IAFhG,uBAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAEsBC,KAAA,CAAAC,QAAQ,GAAAF,MAAA;IAAGG,OAAK,EAAAJ,MAAA,QAAAA,MAAA,MAFtCK,SAAA,KAAAC,IAAA,KAE8CC,QAAA,CAAAC,cAAA,IAAAD,QAAA,CAAAC,cAAA,IAAAF,IAAA,CAAc;IAAEG,WAAW,EAAC;iEAApDP,KAAA,CAAAC,QAAQ,E,GACxBJ,mBAAA,CAAyD,OAAzDW,UAAyD,8B","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}