{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/esnext.iterator.map.js\";\nimport maplibregl from 'maplibre-gl'; // Nhớ cài đặt maplibre-gl\n\nexport default {\n  props: {\n    selectedLocation: {\n      type: Array,\n      default: () => [105.85242472181584, 21.029579719995272]\n    }\n  },\n  data() {\n    return {\n      apiUrl: 'https://rsapi.goong.io',\n      mapUrl: 'https://tiles.goong.io/assets/',\n      apiKey: 'ArPlUISaEBAdJFTABi9dcNGcue8WQ4cOAuGcNoBE',\n      // your API key\n      mapKey: 'tLyW2vk0aY3yfQLu8ZPy986mAgaW8igMYufv3BLY',\n      // your map key\n      center: [105.85242472181584, 21.029579719995272],\n      // Kinh độ, vĩ độ\n      zoom: 14,\n      // Độ zoom mặc định\n      radiusInMeters: 100\n    };\n  },\n  mounted() {\n    this.initMap();\n  },\n  watch: {\n    selectedLocation: 'moveToLocation'\n  },\n  methods: {\n    initMap() {\n      const map = new maplibregl.Map({\n        container: 'map',\n        style: `${this.mapUrl}goong_map_web.json?api_key=${this.mapKey}`,\n        center: [this.selectedLocation[0], this.selectedLocation[1]],\n        zoom: this.zoom\n      });\n      map.on('load', () => {\n        const circleData = {\n          'type': 'FeatureCollection',\n          'features': [{\n            'type': 'Feature',\n            'geometry': {\n              'type': 'Polygon',\n              'coordinates': [this.drawCircle(this.center, this.radiusInMeters)]\n            }\n          }]\n        };\n        map.addSource('circle', {\n          'type': 'geojson',\n          'data': circleData\n        });\n        console.log(\"marker LngLat: \", this.center);\n        const lngLat = [this.center[0], this.center[1]]; // Lấy giá trị từ Proxy\n        new maplibregl.Marker().setLngLat(lngLat).addTo(map);\n        map.addLayer({\n          id: 'circle',\n          type: 'fill',\n          source: 'circle',\n          layout: {},\n          paint: {\n            'fill-color': '#588888',\n            'fill-opacity': 0.5\n          }\n        });\n      });\n\n      // this.map = map; // Lưu map vào this.map để sử dụng ở các phương thức khác\n    },\n    moveToLocation(newLocation) {\n      this.map.flyTo({\n        center: newLocation,\n        essential: true\n      });\n      this.addMarkerAndCircleAround(newLocation);\n    },\n    removeLayer(layerId) {\n      if (this.map.getLayer(layerId)) {\n        this.map.removeLayer(layerId);\n      }\n    },\n    addMarker(lngLat) {\n      new maplibregl.Marker().setLngLat(lngLat).addTo(this.map);\n    },\n    addMarkerAndCircleAround(lngLat) {\n      console.log('Adding circle and marker at:', lngLat, 'with radius:', this.radiusInMeters);\n\n      // Thêm marker tại vị trí mới\n      const marker = new maplibregl.Marker().setLngLat(lngLat).addTo(this.map);\n      if (marker) {\n        console.log('Marker added successfully at:', lngLat);\n      } else {\n        console.error('Failed to add marker at:', lngLat);\n      }\n\n      // Xóa vòng tròn cũ nếu có\n      this.removeLayer('circle');\n\n      // Tạo dữ liệu cho vòng tròn\n      const circleData = {\n        'type': 'FeatureCollection',\n        'features': [{\n          'type': 'Feature',\n          'geometry': {\n            'type': 'Polygon',\n            'coordinates': [this.drawCircle(lngLat, this.radiusInMeters)]\n          }\n        }]\n      };\n\n      // Kiểm tra xem nguồn đã tồn tại chưa trước khi thêm\n      if (this.map.getSource('circle')) {\n        this.map.removeSource('circle');\n      }\n\n      // Thêm source cho vòng tròn\n      this.map.addSource('circle', {\n        'type': 'geojson',\n        'data': circleData\n      });\n\n      // Thêm layer cho vòng tròn\n      this.map.addLayer({\n        'id': 'circle',\n        'type': 'fill',\n        'source': 'circle',\n        'layout': {},\n        'paint': {\n          'fill-color': '#588888',\n          'fill-opacity': 0.5\n        }\n      });\n\n      // Di chuyển đến vị trí mới\n      this.map.flyTo({\n        center: lngLat,\n        zoom: 14\n      });\n    },\n    drawCircle(center, radius) {\n      const points = 64; // Số điểm để vẽ vòng tròn\n      const coords = [];\n      for (let i = 0; i <= points; i++) {\n        const angle = i / points * 2 * Math.PI; // Tính toán góc\n        const dx = radius * Math.cos(angle); // Tính toán độ dịch chuyển theo kinh độ\n        const dy = radius * Math.sin(angle); // Tính toán độ dịch chuyển theo vĩ độ\n        coords.push([center[0] + dx / 111320,\n        // Kinh độ\n        center[1] + dy / 110574 // Vĩ độ\n        ]);\n      }\n      coords.push(coords[0]); // Đảm bảo vòng tròn khép kín\n\n      return coords;\n    }\n  }\n};","map":{"version":3,"names":["maplibregl","props","selectedLocation","type","Array","default","data","apiUrl","mapUrl","apiKey","mapKey","center","zoom","radiusInMeters","mounted","initMap","watch","methods","map","Map","container","style","on","circleData","drawCircle","addSource","console","log","lngLat","Marker","setLngLat","addTo","addLayer","id","source","layout","paint","moveToLocation","newLocation","flyTo","essential","addMarkerAndCircleAround","removeLayer","layerId","getLayer","addMarker","marker","error","getSource","removeSource","radius","points","coords","i","angle","Math","PI","dx","cos","dy","sin","push"],"sources":["/home/sonhippo/Documents/2.Seminar 7/2. PBL6/PBL-6/map/front/src/components/MapComponent.vue"],"sourcesContent":["<template>\n    <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\n</template>\n\n<script>\nimport maplibregl from 'maplibre-gl'; // Nhớ cài đặt maplibre-gl\n\nexport default {\n    props: {\n        selectedLocation: {\n            type: Array,\n            default: () => [105.85242472181584, 21.029579719995272]\n        }\n    },\n    data() {\n        return {\n            apiUrl: 'https://rsapi.goong.io',\n            mapUrl: 'https://tiles.goong.io/assets/',\n            apiKey: 'ArPlUISaEBAdJFTABi9dcNGcue8WQ4cOAuGcNoBE', // your API key\n            mapKey: 'tLyW2vk0aY3yfQLu8ZPy986mAgaW8igMYufv3BLY', // your map key\n            center: [105.85242472181584, 21.029579719995272], // Kinh độ, vĩ độ\n            zoom: 14, // Độ zoom mặc định\n            radiusInMeters: 100,\n        };\n    },\n    mounted() {\n        this.initMap();\n    },\n    watch: {\n        selectedLocation: 'moveToLocation'\n    },\n    methods: {\n        initMap() {\n            const map = new maplibregl.Map({\n                container: 'map',\n                style: `${this.mapUrl}goong_map_web.json?api_key=${this.mapKey}`,\n                center: [this.selectedLocation[0], this.selectedLocation[1]] ,\n                zoom: this.zoom\n            });\n\n            map.on('load', () => {\n                const circleData = {\n                    'type': 'FeatureCollection',\n                    'features': [{\n                        'type': 'Feature',\n                        'geometry': {\n                            'type': 'Polygon',\n                            'coordinates': [this.drawCircle(this.center, this.radiusInMeters)]\n                        }\n                    }]\n                };\n\n                map.addSource('circle', {\n                    'type': 'geojson',\n                    'data': circleData\n                });\n\n                console.log(\"marker LngLat: \", this.center)\n                const lngLat = [this.center[0], this.center[1]]; // Lấy giá trị từ Proxy\n                new maplibregl.Marker()\n                    .setLngLat(lngLat)\n                    .addTo(map);\n\n                map.addLayer({\n                    id: 'circle',\n                    type: 'fill',\n                    source: 'circle',\n                    layout: {},\n                    paint: {\n                        'fill-color': '#588888',\n                        'fill-opacity': 0.5\n                    }\n                });\n            });\n\n            // this.map = map; // Lưu map vào this.map để sử dụng ở các phương thức khác\n        },\n        moveToLocation(newLocation) {\n            this.map.flyTo({\n                center: newLocation,\n                essential: true\n            });\n            this.addMarkerAndCircleAround(newLocation);\n        },\n        removeLayer(layerId) {\n            if (this.map.getLayer(layerId)) {\n                this.map.removeLayer(layerId);\n            }\n        },\n        addMarker(lngLat) {\n            new maplibregl.Marker()\n                .setLngLat(lngLat)\n                .addTo(this.map);\n        },\n        addMarkerAndCircleAround(lngLat) {\n            console.log('Adding circle and marker at:', lngLat, 'with radius:', this.radiusInMeters);\n\n            // Thêm marker tại vị trí mới\n            const marker = new maplibregl.Marker()\n                .setLngLat(lngLat)\n                .addTo(this.map);\n            \n            if (marker) {\n                console.log('Marker added successfully at:', lngLat);\n            } else {\n                console.error('Failed to add marker at:', lngLat);\n            }\n\n            // Xóa vòng tròn cũ nếu có\n            this.removeLayer('circle');\n\n            // Tạo dữ liệu cho vòng tròn\n            const circleData = {\n                'type': 'FeatureCollection',\n                'features': [{\n                    'type': 'Feature',\n                    'geometry': {\n                        'type': 'Polygon',\n                        'coordinates': [this.drawCircle(lngLat, this.radiusInMeters)]\n                    }\n                }]\n            };\n\n            // Kiểm tra xem nguồn đã tồn tại chưa trước khi thêm\n            if (this.map.getSource('circle')) {\n                this.map.removeSource('circle');\n            }\n\n            // Thêm source cho vòng tròn\n            this.map.addSource('circle', {\n                'type': 'geojson',\n                'data': circleData\n            });\n\n            // Thêm layer cho vòng tròn\n            this.map.addLayer({\n                'id': 'circle',\n                'type': 'fill',\n                'source': 'circle',\n                'layout': {},\n                'paint': {\n                    'fill-color': '#588888',\n                    'fill-opacity': 0.5\n                }\n            });\n\n            // Di chuyển đến vị trí mới\n            this.map.flyTo({ center: lngLat, zoom: 14 });\n        },\n        drawCircle(center, radius) {\n            const points = 64; // Số điểm để vẽ vòng tròn\n            const coords = [];\n\n            for (let i = 0; i <= points; i++) {\n                const angle = (i / points) * 2 * Math.PI; // Tính toán góc\n                const dx = radius * Math.cos(angle); // Tính toán độ dịch chuyển theo kinh độ\n                const dy = radius * Math.sin(angle); // Tính toán độ dịch chuyển theo vĩ độ\n                coords.push([\n                    center[0] + dx / 111320, // Kinh độ\n                    center[1] + dy / 110574  // Vĩ độ\n                ]);\n            }\n            coords.push(coords[0]); // Đảm bảo vòng tròn khép kín\n\n            return coords;\n        }\n    }\n};\n</script>\n\n<style>\n#map {\n    width: 100%;\n    height: 100vh;\n    /* Chiều cao của bản đồ */\n}\n</style>"],"mappings":";;AAKA,OAAOA,UAAS,MAAO,aAAa,EAAE;;AAEtC,eAAe;EACXC,KAAK,EAAE;IACHC,gBAAgB,EAAE;MACdC,IAAI,EAAEC,KAAK;MACXC,OAAO,EAAEA,CAAA,KAAM,CAAC,kBAAkB,EAAE,kBAAkB;IAC1D;EACJ,CAAC;EACDC,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,MAAM,EAAE,wBAAwB;MAChCC,MAAM,EAAE,gCAAgC;MACxCC,MAAM,EAAE,0CAA0C;MAAE;MACpDC,MAAM,EAAE,0CAA0C;MAAE;MACpDC,MAAM,EAAE,CAAC,kBAAkB,EAAE,kBAAkB,CAAC;MAAE;MAClDC,IAAI,EAAE,EAAE;MAAE;MACVC,cAAc,EAAE;IACpB,CAAC;EACL,CAAC;EACDC,OAAOA,CAAA,EAAG;IACN,IAAI,CAACC,OAAO,CAAC,CAAC;EAClB,CAAC;EACDC,KAAK,EAAE;IACHd,gBAAgB,EAAE;EACtB,CAAC;EACDe,OAAO,EAAE;IACLF,OAAOA,CAAA,EAAG;MACN,MAAMG,GAAE,GAAI,IAAIlB,UAAU,CAACmB,GAAG,CAAC;QAC3BC,SAAS,EAAE,KAAK;QAChBC,KAAK,EA