{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.for-each.js\";\nimport \"core-js/modules/esnext.iterator.map.js\";\nimport maplibregl from 'maplibre-gl'; // Nhập khẩu maplibregl\n\nexport default {\n  mounted() {\n    // Khởi tạo bản đồ sau khi component được gắn vào DOM\n    this.initMap();\n    this.setupAutocomplete();\n  },\n  methods: {\n    initMap() {\n      const apiUrl = 'https://rsapi.goong.io'; // Sử dụng biến này khi gọi API\n      const mapUrl = 'https://tiles.goong.io/assets/';\n      const apiKey = 'ArPlUISaEBAdJFTABi9dcNGcue8WQ4cOAuGcNoBE'; // Sử dụng biến này khi gọi API\n      const mapKey = 'tLyW2vk0aY3yfQLu8ZPy986mAgaW8igMYufv3BLY';\n      const center = [105.85242472181584, 21.029579719995272];\n      const zoom = 14;\n      const radiusInMeters = 100; // Sử dụng biến này trong drawCircle\n\n      this.map = new maplibregl.Map({\n        container: 'map',\n        style: `${mapUrl}/goong_map_web.json?api_key=${mapKey}`,\n        center: center,\n        zoom: zoom\n      });\n      this.map.on('load', () => {\n        this.addMarkerAndCircleAround(center);\n      });\n    },\n    setupAutocomplete() {\n      document.getElementById('input').addEventListener('input', event => {\n        const query = event.target.value;\n        if (query.length >= 2) {\n          this.fetchDataAutoComplete(query);\n        } else {\n          this.renderArray([]); // Clear results if input is less than 2 characters\n        }\n      });\n    },\n    fetchDataAutoComplete(query) {\n      const apiUrl = 'https://rsapi.goong.io'; // Sử dụng biến này khi gọi API\n      const apiLink = `${apiUrl}/Place/AutoComplete?api_key=${apiKey}&input=${encodeURIComponent(query)}`;\n      fetch(apiLink).then(response => response.json()).then(data => {\n        if (data.predictions) {\n          this.renderArray(data.predictions);\n        } else {\n          this.renderArray([]);\n        }\n      }).catch(error => {\n        console.error('Error fetching data:', error);\n        this.renderArray([]);\n      });\n    },\n    renderArray(data) {\n      const resultContainer = document.getElementById('result');\n      resultContainer.innerHTML = ''; // Clear previous results\n      if (data.length > 0) {\n        resultContainer.style.display = 'block';\n      } else {\n        resultContainer.style.display = 'none';\n      }\n      data.forEach(item => {\n        const div = document.createElement('div');\n        div.className = 'result-box';\n        div.textContent = item.description;\n        div.addEventListener('click', () => {\n          this.fetchPlaceDetails(item.place_id);\n          resultContainer.style.display = 'none';\n          document.getElementById('input').value = item.description;\n        });\n        resultContainer.appendChild(div);\n      });\n    },\n    fetchPlaceDetails(placeId) {\n      const apiUrl = 'https://rsapi.goong.io'; // Sử dụng biến này khi gọi API\n      const apiKey = 'ArPlUISaEBAdJFTABi9dcNGcue8WQ4cOAuGcNoBE'; // Sử dụng biến này khi gọi API\n      const apiLink = `${apiUrl}/Place/Detail?api_key=${apiKey}&place_id=${placeId}`;\n      fetch(apiLink).then(response => response.json()).then(data => {\n        if (data.result) {\n          const {\n            location\n          } = data.result.geometry;\n          const lngLat = [location.lng, location.lat];\n          this.addMarkerAndCircleAround(lngLat);\n        } else {\n          console.error('No result found for place details');\n        }\n      }).catch(error => {\n        console.error('Error fetching place details:', error);\n      });\n    },\n    addMarkerAndCircleAround(lngLat) {\n      new maplibregl.Marker().setLngLat(lngLat).addTo(this.map);\n      const circleData = {\n        'type': 'FeatureCollection',\n        'features': [{\n          'type': 'Feature',\n          'geometry': {\n            'type': 'Polygon',\n            'coordinates': [this.drawCircle(lngLat, 100)]\n          }\n        }]\n      };\n      this.map.addSource('circle', {\n        'type': 'geojson',\n        'data': circleData\n      });\n      this.map.addLayer({\n        'id': 'circle',\n        'type': 'fill',\n        'source': 'circle',\n        'layout': {},\n        'paint': {\n          'fill-color': '#588888',\n          'fill-opacity': 0.5\n        }\n      });\n      this.map.flyTo({\n        center: lngLat,\n        zoom: 14\n      });\n    },\n    drawCircle(center, radiusInMeters) {\n      const points = 64;\n      const coords = {\n        latitude: center[1],\n        longitude: center[0]\n      };\n      const km = radiusInMeters / 1000; // Sử dụng biến này\n      const ret = [];\n      const distanceX = km / (111.320 * Math.cos(coords.latitude * Math.PI / 180));\n      const distanceY = km / 110.574;\n      let theta, x, y;\n      for (let i = 0; i < points; i++) {\n        theta = i / points * (2 * Math.PI);\n        x = distanceX * Math.cos(theta);\n        y = distanceY * Math.sin(theta);\n        ret.push([coords.longitude + x, coords.latitude + y]);\n      }\n      ret.push(ret[0]); // Close the circle\n      return ret;\n    }\n  }\n};","map":{"version":3,"names":["maplibregl","mounted","initMap","setupAutocomplete","methods","apiUrl","mapUrl","apiKey","mapKey","center","zoom","radiusInMeters","map","Map","container","style","on","addMarkerAndCircleAround","document","getElementById","addEventListener","event","query","target","value","length","fetchDataAutoComplete","renderArray","apiLink","encodeURIComponent","fetch","then","response","json","data","predictions","catch","error","console","resultContainer","innerHTML","display","forEach","item","div","createElement","className","textContent","description","fetchPlaceDetails","place_id","appendChild","placeId","result","location","geometry","lngLat","lng","lat","Marker","setLngLat","addTo","circleData","drawCircle","addSource","addLa